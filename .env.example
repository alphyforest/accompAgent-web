DEEPSEEK_API_KEY=sk-xxx
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
REASONING_EFFORT=low

HOST=0.0.0.0
PORT=5000

MAX_HISTORY=10
GLOBAL_COOLDOWN=3

# --- 第二阶段：语义化长期记忆 ---
MEMORY_DB_PATH=./data/memory.db
MEMORY_IDLE_TIMEOUT_MINUTES=60
MEMORY_SEGMENT_MAX_MESSAGES=30
MEMORY_INJECT_TOP_K=8
MEMORY_FORGET_DAYS=30
MEMORY_FORGET_DECAY=2

PHRASES_DIR=./phrases
CONFIG_DIR=./src/config/roles
DATA_DIR=./data

# --- 第三阶段：MCP 工具引擎（Agenda MCP Server 接入）---
# 总开关；关闭则 agenda 工具不入注册表（内置 now 演示工具仍保留）
AGENDA_MCP_ENABLED=true
# node + tsx CLI 入口 + server.ts（Windows 不以 .cmd 直启，可含绝对路径）
AGENDA_MCP_COMMAND=node
AGENDA_MCP_ARGS=["F:\lab\agenda1\node_modules\tsx\dist\cli.mjs", "F:\lab\agenda1\mcp\server.ts"]
# 共享数据文件（与 agenda 桌面端同一文件）
AGENDA_DATA_PATH=F:\lab\agenda1\agenda-data.json
# ToolLoop 参数
AGENDA_TOOL_ROUNDS=4
AGENDA_TOOL_TIMEOUT=30
AGENDA_TOOL_OVERALL_TIMEOUT=120
# 每日备份目录
AGENDA_DATA_BACKUP_DIR=./data/agenda_backup
