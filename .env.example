DEEPSEEK_API_KEY=sk-xxx
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
REASONING_EFFORT=low

# 服务监听（R6：默认本地绑定，分发不覆盖为 0.0.0.0）
HOST=127.0.0.1
PORT=5000

# --- 长期记忆 ---
# 相对路径落入用户数据目录（Windows: %LOCALAPPDATA%\ai-agent\data）
MEMORY_DB_PATH=memory.db
MEMORY_IDLE_TIMEOUT_MINUTES=60
MEMORY_SEGMENT_MAX_MESSAGES=30
MEMORY_INJECT_TOP_K=8
MEMORY_FORGET_DAYS=30
MEMORY_FORGET_DECAY=2

CONFIG_DIR=./src/config/roles

# --- 第三阶段：MCP 工具引擎（可选来源，R6 起默认未配置）---
# 关闭或留空时 Agenda 工具不可用但服务正常启动（降级普通对话）
AGENDA_MCP_ENABLED=true
# 本地部署示例：node + tsx 入口 + server.ts（Windows 不以 .cmd 直启）
AGENDA_MCP_COMMAND=
AGENDA_MCP_ARGS=[]
# 共享数据文件（与 agenda 桌面端同一文件，可选）
AGENDA_DATA_PATH=
# ToolLoop 参数
AGENDA_TOOL_ROUNDS=4
AGENDA_TOOL_TIMEOUT=30
AGENDA_TOOL_OVERALL_TIMEOUT=120
# 每日备份目录（留空使用用户备份目录）
AGENDA_DATA_BACKUP_DIR=
