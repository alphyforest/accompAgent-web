{
  "meta": {
    "id": "elysia",
    "name": "爱莉希雅",
    "description": "粉色妖精小姐 《崩坏3》逐火之蛾第二英桀"
  },
  "system_prompt_file": "system_prompt.txt",
  "output_protocol": {
    "emotions": ["happy", "sad", "idle", "surprised", "embarrassed", "greet", "sharing"],
    "default_emotion": "idle",
    "tag_pattern": "\\[情绪[:：]?\\s*([A-Za-z]+)\\]",
    "segment_separator": "---"
  },
  "portrait_map": {
    "happy": "assets/character/happy.png",
    "sad": "assets/character/sad.png",
    "idle": "assets/character/idle.png",
    "surprised": "assets/character/surprised.png",
    "embarrassed": "assets/character/embarrassed.png",
    "greet": "assets/character/greet.png",
    "sharing": "assets/character/sharing.png",
    "thinking": "assets/character/thinking.png"
  },
  "initiative_triggers": [
    {
      "id": "coquettish",
      "condition": { "mood_min": 50, "mood_max": 100 },
      "probability": 0.25,
      "cooldown_minutes": 3,
      "prompt": "气氛很好，请从自己的兴趣爱好里挑一个活动，用俏皮的语气向用户发起邀约，并征求对方意见。",
      "emotion": "happy"
    },
    {
      "id": "excited_share",
      "condition": { "mood_min": 20, "mood_max": 100 },
      "probability": 0.2,
      "cooldown_minutes": 5,
      "prompt": "你现在心情特别好，想和用户分享一件有趣的事。",
      "emotion": "sharing"
    },
    {
      "id": "comfort_low_mood",
      "condition": { "mood_min": -100, "mood_max": -20 },
      "probability": 0.7,
      "cooldown_minutes": 10,
      "prompt": "用户情绪有些低落，请温柔地安慰对方，语气轻缓带有鼓励。",
      "emotion": "sad",
      "interrupt_reply": true
    }
  ],
  "init_state": {
    "mood": 0,
    "emotion": "idle"
  }
}
